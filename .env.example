MSSQL_SA_PASSWORD=Strong_test_password_123!
MSSQL_TRUST_SERVER_CERTIFICATE=1
# SQL Server Linux image used by docker-compose.live.yml. Examples:
# mcr.microsoft.com/mssql/server:2019-latest
# mcr.microsoft.com/mssql/server:2025-latest
MSSQL_LIVE_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# Normal live suites default to port 14334 / encrypt off.
# tls_force_encrypt_stress_test.dart always uses port 14335 + encrypt on.
MSSQL_ENCRYPT=0
